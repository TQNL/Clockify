<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <!--
        Samsung-style contextual alarm/folder actions. Item visibility is
        driven dynamically by AlarmsAdapter.prepareActionMode() based on the
        current selection (see SelectionActions.kt). All items start hidden
        and are shown only when computeActions() returns them.
    -->
    <item
        android:id="@+id/cab_turn_on"
        android:icon="@drawable/ic_power_on_vector"
        android:title="@string/turn_on"
        android:visible="false"
        app:showAsAction="always" />
