        android:visible="false"
        app:showAsAction="always" />
    <item
        android:id="@+id/cab_ungroup"
        android:icon="@drawable/ic_ungroup_vector"
        android:title="@string/ungroup"
        android:visible="false"
        app:showAsAction="always" />
    <item
        android:id="@+id/cab_delete"
